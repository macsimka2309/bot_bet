# Скопируйте в .env и заполните. Файл .env в Git не попадает.
TELEGRAM_BOT_TOKEN=
# Для канала идентификатор обычно вида -100XXXXXXXXXX; команда `python -m bot_bet check`
# сама подскажет рабочее значение, если указать голое число.
TELEGRAM_CHAT_ID=
# Необязательно: SOCKS-прокси, если с этой машины Telegram недоступен.
# Пример: socks5h://127.0.0.1:1080
TELEGRAM_PROXY=
